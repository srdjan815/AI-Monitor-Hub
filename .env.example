# Environment variables for AI Cenovnici API

# API Configuration
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["*"]

# Environment
ENVIRONMENT=development

# Database
POSTGRES_DB=ai_cenovnici
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/ai_cenovnici
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379
REDIS_DB=0
