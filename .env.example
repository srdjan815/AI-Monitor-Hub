# Environment variables for AI Cenovnici API

# API Configuration
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["*"]
BACKEND_ALLOWED_HOSTS=["*"]
CORS_ALLOW_CREDENTIALS=false
MAX_REQUEST_BODY_BYTES=2097152

# Environment
APP_ENV=development
SUPPLIER_WARNING_HOURS=24
SUPPLIER_ARTICLE_DROP_RATIO=0.5
AUTH_SECRET=development-only-change-me
AUTH_KEY_ID=local-development
AUTH_PREVIOUS_KEYS={}
AUTH_ISSUER=ai-monitor-hub
AUTH_AUDIENCE=ai-monitor-hub-api
AUTH_TOKEN_VERSION=1
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_ALLOW_LEGACY_TOKENS=true
# Docker deployment namešta AUTH_MODE=static i čita token iz .env.secrets.
AUTH_MODE=test_jwt
AUTH_SESSION_TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SUPPLIER_SECRETS_FILE=/app/config/supplier-secrets.json
SUPPLIER_SECRET_MODE=test_memory
# Obavezno samo za SUPPLIER_SECRET_MODE=encrypted_file. Čuvati kao Docker secret.
# Generisanje: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SUPPLIER_SECRETS_KEY=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_SHARED_REQUIRED=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
RATE_LIMIT_NAMESPACE=amh:rate-limit:v1
RATE_LIMIT_BACKEND_TIMEOUT_SECONDS=0.5
RATE_LIMIT_REDIS_MAX_CONNECTIONS=20
RATE_LIMIT_FAIL_OPEN_READS=true
RATE_LIMIT_FAIL_OPEN_MUTATIONS=false
RATE_LIMIT_TRUSTED_PROXY_CIDRS=[]
METRICS_ENABLED=true
STRUCTURED_LOGGING=true
DOCS_ENABLED=true
PRODUCT_CONTENT_TRUSTED_RAW_PREVIEW=false

# Database
POSTGRES_DB=ai_cenovnici
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-development-password
DATABASE_URL=postgresql+asyncpg://postgres:local-development-password@db:5432/ai_cenovnici
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379
REDIS_DB=0
# Central supplier data-quality policy (applies to every supplier)
SUPPLIER_CRITICAL_PRICE_INCREASE_RATIO=3
SUPPLIER_CRITICAL_PRICE_DECREASE_RATIO=0.5
SUPPLIER_SHARED_EAN_AUTO_ACCEPT_SIMILARITY=0.8
SUPPLIER_SHARED_EAN_MANUAL_REVIEW_SIMILARITY=0.6
